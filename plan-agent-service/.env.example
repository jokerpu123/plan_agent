# Agent 服务端口
AGENT_PORT=8090

# Spring Boot 业务 API 地址
SPRING_API_BASE=http://localhost:8080

# DeepSeek V4（OpenAI 兼容接口）
# 在 https://platform.deepseek.com 申请 API Key
OPENAI_API_KEY=your-api-key

# 模型：deepseek-v4-flash（快、省）| deepseek-v4-pro（推理更强）
OPENAI_MODEL=deepseek-chat

# DeepSeek 固定填这个（也可省略，代码里已有默认值）
OPENAI_API_BASE=https://api.deepseek.com

# Redis stores LangGraph checkpoints and interrupted plans.
REDIS_URL=redis://localhost:6380/0
PLAN_MAX_REVISIONS=2
